# Configuration MyRecipeProject
# Copier vers .env et renseigner les valeurs

# PostgreSQL (Neon)
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/myrecipeproject?sslmode=require"

# Session (générer avec : openssl rand -hex 32)
SESSION_SECRET="your-secret-here"

# Cloudflare R2
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
R2_BUCKET_NAME="myrecipeproject-media"
R2_PUBLIC_URL="https://media.myrecipeproject.ci"

# Email (Resend)
RESEND_API_KEY="re_xxxx"
EMAIL_FROM="noreply@myrecipeproject.ci"

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"
